<%- model_class = Photo -%>
<div class="pb-2 mb-4 border-bottom">
  <h1><%=t '.title', default: model_class.model_name.human.titleize %></h1>
</div>

<dl class="row">
  <dt class="col-sm-2"><strong><%= model_class.human_attribute_name(:title) %>:</strong></dt>
  <dd class="col-sm-10"><%= @photo.title %></dd>
  <dt class="col-sm-2"><strong><%= model_class.human_attribute_name(:image) %>:</strong></dt>
  <dd class="col-sm-10"><%= cl_image_tag @photo.image %>
  </dd>
  <dt class="col-sm-2"><strong><%= model_class.human_attribute_name(:bytes) %>:</strong></dt>
  <dd class="col-sm-10"><%= @photo.bytes %></dd>
</dl>

<%= link_to(
  t('.back', default: t("helpers.links.back")),
  photos_path,
  class: 'btn btn-secondary'
) %>
<%= link_to(
  t('.edit', default: t("helpers.links.edit")),
  edit_photo_path(@photo),
  class: 'btn btn-secondary'
) %>
<%= button_to(
  t('.destroy', default: t("helpers.links.destroy")),
  photo_path(@photo),
  method: :delete,
  form: {
    class: 'd-inline',
    data: {
      turbo_confirm: t(
        '.confirm',
        default: t("helpers.links.confirm", default: 'Are you sure?')
      ),
    },
  },
  class: 'btn btn-danger'
) %>
